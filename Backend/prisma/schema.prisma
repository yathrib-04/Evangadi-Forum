// This schema describes the database the app actually queries (see
// Backend/Controller/*.js, which use raw mysql2 SQL). Table and column names are
// mapped explicitly so Prisma and the raw queries stay in agreement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userid    Int        @id @default(autoincrement())
  username  String     @unique
  firstname String
  lastname  String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now()) @map("created_at")
  questions Question[]
  answers   Answer[]

  @@map("users")
}

model Question {
  questionid  String   @id @default(uuid()) @db.Char(36)
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  userid      Int
  user        User     @relation(fields: [userid], references: [userid])
  answers     Answer[]

  @@map("questions")
}

model Answer {
  answerid   Int      @id @default(autoincrement())
  answer     String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  userid     Int
  questionid String   @db.Char(36)
  user       User     @relation(fields: [userid], references: [userid])
  question   Question @relation(fields: [questionid], references: [questionid])

  @@map("answers")
}
