# Copy this file to .env and fill in your own values.

# Server
PORT=5000

# MySQL connection used by the app (mysql2 pool)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=evangadi_forum

# Same connection, in the URL form Prisma CLI expects
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/evangadi_forum"

# Secret used to sign JWTs - use a long random string
JWT_SECRET=replace_me_with_a_long_random_string

# Origin allowed to call this API. In production set it to your deployed
# frontend's origin, or the browser will block every request.
CORS_ORIGIN=http://localhost:3000

# Public origin of THIS API, used as the server URL in the Swagger docs.
# Leave unset locally; set it in production (e.g. https://api.example.com).
# PUBLIC_API_URL=
